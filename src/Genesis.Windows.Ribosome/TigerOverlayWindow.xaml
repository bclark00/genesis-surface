<Window x:Class="Genesis.Windows.Ribosome.TigerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True" Focusable="True"
        IsHitTestVisible="True" ResizeMode="NoResize"
        Width="300" Height="240">
  <Border Background="#EB141414" BorderBrush="#80FF8C00" BorderThickness="1"
          CornerRadius="12" Padding="14" ClipToBounds="True">
    <Grid Background="Transparent" PreviewMouseLeftButtonDown="OnSurfacePreviewMouseLeftButtonDown">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="Header" Grid.Row="0" Text="🐅 Genesis / Tiger"
                 Foreground="#FFFF8C00" FontSize="14" FontWeight="Bold"
                 Margin="0,0,0,8" Cursor="SizeAll"
                 MouseLeftButtonDown="OnHeaderMouseLeftButtonDown" />
      <StackPanel x:Name="SurfacePanel" Grid.Row="1" ClipToBounds="True" />
      <Button x:Name="DiagnoseButton" Grid.Row="2" Content="diagnose"
              HorizontalAlignment="Left" Margin="0,9,0,0" Padding="8,4"
              Background="#FF2B2118" Foreground="#FFFFB347"
              BorderBrush="#FF8B5A2B" Click="OnDiagnoseClick" />
    </Grid>
  </Border>
</Window>
